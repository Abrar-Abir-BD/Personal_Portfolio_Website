# abrarabir.com (cPanel hosting). Vercel ignores this file and uses vercel.json

# /art is served from art/index.html as it is, with no redirect to /art/
DirectorySlash Off
# Keeps the 404 status for search engines; the app shows its "not found" page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address for the site: https, no www. The SSL certificate renewal check
  # needs plain http, so .well-known is left out
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://abrarabir.com%{REQUEST_URI} [R=301,L]

  # Pages built ahead of time: /art -> art/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# Same caching as vercel.json
<IfModule mod_headers.c>
  # Pages are always checked, so visitors get new builds straight away
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Built files have a hash in their name, which changes when they do
  <FilesMatch "-[\w-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|hdr|wasm|webp|png|jpe?g|avif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
</IfModule>
