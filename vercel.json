{
  "rewrites": [
    { "source": "/projects/:slug", "destination": "/index.html" },
    { "source": "/art", "destination": "/index.html" },
    { "source": "/certificates", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(models|draco|images)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
